!*.dvc

# Credenciales locales de DVC (nunca se versionan)
.dvc/config.local

# Modelos entrenados (pesados)
models/*.pkl
!models/.gitkeep

# Jupyter
.ipynb_checkpoints/

# Python
__pycache__/
*.pyc

# Variables de entorno / secretos
.env

# VS Code
.vscode/